+/// Zamin turiga mos qadam tovushi.
+pub fn step_sfx(b: u8) -> Sfx {
+    match b {
+        SAND => Sfx::StepSand,
+        SNOW => Sfx::StepSnow,
+        STONE | COBBLE | COAL_ORE | IRON_ORE | GOLD_ORE | DIAMOND_ORE | REDSTONE_ORE | BRICK | FURNACE | GLASS | CRYSTAL => Sfx::StepStone,
+        PLANK | LOG | CRAFTING | CHEST | LOOTCHEST | ENCHANT => Sfx::StepWood,
+        _ => Sfx::StepGrass,
+    }
+}
+
+/// Yer turi va iqlimga qarab hayvon tanlaydi: o'rmonda kiyik, cho'lda tuya, qor/tundrada ayiq, dalada sigir-qo'y-tovuq.
+pub fn pick_animal(surface: u8, bio: u8, r: f32) -> Option<u8> {
+    use crate::earth;
+    match surface {
+        SAND if bio == earth::DESERT => Some(entity::CAMEL),
+        SNOW => Some(entity::BEAR),
+        GRASS if bio == earth::FOREST => Some(if r < 0.6 { entity::DEER } else if r < 0.8 { entity::COW } else { entity::SHEEP }),
+        GRASS => Some(if r < 0.3 { entity::COW } else if r < 0.6 { entity::SHEEP } else if r < 0.85 { entity::CHICKEN } else { entity::DEER }),
+        DRYGRASS => Some(if r < 0.6 { entity::DEER } else { entity::SHEEP }),
+        _ => None,
+    }
+}
+
+/// Haqiqiy sana bo'yicha yil fasli [0,1).
+pub fn real_season() -> f32 {
+    let secs = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_secs_f64()).unwrap_or(0.0);
+    (((secs / 86400.0) % 365.2425) / 365.2425) as f32
+}
+
+/// Fasl nomi (shimoliy yarim shar) va keyingi faslning o'rtasi.
+pub fn season_name(f: f32) -> &'static str {
+    match f {
+        x if (0.17..0.42).contains(&x) => "BAHOR",
+        x if (0.42..0.67).contains(&x) => "YOZ",
+        x if (0.67..0.92).contains(&x) => "KUZ",
+        _ => "QISH",
+    }
+}
+
+fn bump(x: f32, c: f32, w: f32) -> f32 {
+    let d = (x - c).abs().min((x - c + 1.0).abs()).min((x - c - 1.0).abs());
+    (1.0 - d / w).clamp(0.0, 1.0)
+}
