         assert_eq!(same.top, d.top);
     }
+
+    #[test]
+    fn haqiqiy_quyosh_kenglik_va_fasl() {
+        let at = |lat: f32| {
+            let la = lat.to_radians();
+            v3(la.cos(), la.sin(), 0.0)
+        };
+        let elev = |t: f32, lat: f32, decl: f32| sun_dir(t, at(lat), decl).dot(at(lat));
+        let eq = 0.0;
+        let sum = declination(0.47); // iyun oxiri
+        let win = declination(0.97); // dekabr
+        assert!((sum.to_degrees() - 23.4).abs() < 1.0 && (win.to_degrees() + 23.4).abs() < 1.0);
+        // ekvatorda tush: deyarli tepada
+        assert!(elev(0.25, 0.0, eq) > 0.99);
+        // Toshkentda yozda tush balandroq, qishda past
+        assert!(elev(0.25, 41.0, sum) > elev(0.25, 41.0, win) + 0.5);
+        // qutbda yozda yarim tunda ham quyosh ufqdan tepada (qutb kuni), qishda tushda ham pastda
+        assert!(elev(0.75, 80.0, sum) > 0.0, "qutb kuni");
+        assert!(elev(0.25, 80.0, win) < 0.0, "qutb tuni");
+        // kun uzunligi: qishda Toshkentda tun uzun
+        let day_len = |decl: f32| (0..240).filter(|&i| elev(i as f32 / 240.0, 41.0, decl) > 0.0).count();
+        assert!(day_len(sum) > day_len(win) + 30, "{} {}", day_len(sum), day_len(win));
+        assert!((day_len(eq) as i32 - 120).abs() < 8);
+        // quyosh yo'nalishi birlik vektor
+        for i in 0..50 {
+            assert!((sun_dir(i as f32 / 50.0, at(41.0), sum).len() - 1.0).abs() < 1e-4);
+        }
+    }
 }
