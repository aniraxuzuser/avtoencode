+
+    #[test]
+    fn muhit_tovushlari() {
+        let loud = |f: &dyn Fn(&mut Synth)| {
+            let mut s = Synth::new();
+            s.music = false;
+            f(&mut s);
+            let mut b = vec![0i16; RATE as usize * 3];
+            s.render(&mut b);
+            b.iter().map(|&x| (x as i32).abs()).max().unwrap_or(0)
+        };
+        assert_eq!(loud(&|_| {}), 0);
+        assert!(loud(&|s| s.wind = 1.0) > 300, "shamol");
+        assert!(loud(&|s| s.water = 1.0) > 300, "suv");
+        assert!(loud(&|s| s.crickets = 1.0) > 100, "chirildoq");
+        // qushlar tasodifiy: ko'p urinishda kamida bir marta chiriqlaydi
+        assert!(loud(&|s| s.birds = 1.0) > 100, "qush");
+        // yuqori shamol past shamoldan baland
+        assert!(loud(&|s| s.wind = 1.0) > loud(&|s| s.wind = 0.1));
+    }
 }
